{
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "Illustrious-XL-v2.0.safetensors"}},
  "2": {"class_type": "CLIPSetLastLayer", "inputs": {"clip": ["1", 1], "stop_at_clip_layer": -2}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "masterpiece, best quality, score_9, score_8_up, score_7_up, {{prompt}}",
        "clip": ["2", 0]}},
  "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative}}, lowres, worst quality, low quality, bad anatomy, bad hands, jpeg artifacts",
        "clip": ["2", 0]}},
  "6": {"class_type": "EmptyLatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "7": {"class_type": "KSampler", "inputs": {"model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0],
        "latent_image": ["6", 0], "seed": "{{seed}}", "steps": 28, "cfg": 6.0, "sampler_name": "euler_ancestral",
        "scheduler": "normal", "denoise": 1.0}},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["7", 0], "vae": ["1", 2]}},
  "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "prospero-companion"}}
}
